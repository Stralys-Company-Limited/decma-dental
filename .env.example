# Public site URL (no trailing slash). Used for canonical URLs, sitemap, emails and calendar links.
# On Vercel, leave unset until the domain is connected: the Vercel production address is used instead.
SITE_URL=https://decma.co.tz

# Supabase (Project settings > API). All Supabase access happens on the server.
# On Vercel these are injected by the Supabase integration (its names, e.g. NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_ANON_KEY, are accepted too).
SUPABASE_PROJECT_ID=
SUPABASE_URL=
# The "anon" / publishable key, used for staff sign-in at /admin
SUPABASE_PUBLIC_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
# Sender address. Its domain must be verified in Resend (check with `npm run email:domain`); until then the app
# falls back to Resend's test sender, which only delivers to the Resend account owner's email.
RESEND_FROM="DECMA Dental Clinic <bookings@dental.decma.co.tz>"
# Where new bookings, call-backs and referral enquiries are sent
CLINIC_NOTIFY_EMAIL=
# "Request a call-back" alerts go here instead, if set
CALLBACK_NOTIFY_EMAIL=dental@decma.co.tz

# Published Resend templates for the patient booking confirmation (printed by `npm run email:templates`).
# Leave empty to send the built-in React Email version instead.
RESEND_TEMPLATE_BOOKING_CONFIRMATION_EN=
RESEND_TEMPLATE_BOOKING_CONFIRMATION_SW=
# Public base URL for email images (logo, calendar icons), e.g. https://decma.co.tz once the site is live.
# Defaults to the copies in the public GitHub repository.
EMAIL_ASSET_BASE_URL=

# Protects /api/cron/reminders. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional: salt for hashing IP addresses in the rate limiter (defaults to CRON_SECRET)
RATE_LIMIT_SALT=
