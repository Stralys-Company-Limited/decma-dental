{
  "name": "decma-dental",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=web",
    "dev:clinic": "turbo run dev --filter=clinic",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:push": "pnpm --filter web db:push",
    "email:templates": "pnpm --filter web email:templates",
    "email:domain": "pnpm --filter web email:domain",
    "sms": "pnpm --filter web sms"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5"
  }
}
